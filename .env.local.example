# ============================================================
# BLOOM — Environment Variables Template
# Copy this file to .env.local and fill in real values
# See SETUP.md for step-by-step instructions
# ============================================================

# Supabase (get from: https://supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini API Key is stored as a Supabase Edge Function secret (NOT here)
# See SETUP.md Step 4 — never put GEMINI_API_KEY in this file (it would be exposed in the browser bundle)
